#!/bin/bash

# ---- Create an env_for_PyTools.sh
function create_env_PyTools
{
   : > env_for_PyTools.sh
   echo "#!/bin/bash" > env_for_PyTools.sh
   echo "source $project_directory/$1/venv/bin/activate" >> env_for_PyTools.sh
   echo "export PATH=${project_directory}/share/bin:$PATH" >> env_for_PyTools.sh
   echo "export PYTHONPATH=${project_directory}/$1:$PYTHONPATH"  >> env_for_PyTools.sh
}

function fully_prepare_venv
{
   local path=$1
   python -m venv ${project_directory}/$path/venv 
   [ $? ] && source $project_directory/$path/venv/bin/activate \
       && python -m pip install --upgrade pip \
       && pip install -r $project_directory/$path/requirements.txt \
       && deactivate
   echo "Creating env_for_PyTools.sh in $PWD"
   [ $? ] && create_env_PyTools $path
   [ $? ] && echo "venv for PyTools successfully replaced" \
          && echo "You can use PyTools after : source env_for_PyTools.sh" 
   return 0 # ok
}

function install_mfront
{
  mfront_version=$1

  if [ ! -f share/Mfront/tfel-TFEL-$mfront_version.tar.gz ]; then
    echo "Missing source archive share/Mfront/tfel-TFEL-$mfront_version.tar.gz for the referenced version of Tfel/Mfront"
    exit 1
  fi
    
  current_path=$PWD
  source_dir=$current_path/share/Mfront
  build_dir="$current_path/build/build_mfront_"$mfront_version
  install_dir="$current_path/local/tfel"
  [[ ! -d $build_dir ]] && mkdir $build_dir
  [[ ! -d $install_dir ]] && mkdir $install_dir
  cd $build_dir
  tar -xzvf $source_dir/tfel-TFEL-$mfront_version.tar.gz &> $source_dir/build-tfel-TFEL-$mfront_version.LOG
  mkdir build
  cd build
  echo "CC=$TRUST_cc_BASE CXX=$TRUST_CC_base FC=$TRUST_F77_BASE cmake ../tfel-TFEL-$mfront_version -DCMAKE_BUILD_TYPE=Release -Denable-reference-doc=OFF -Denable-website=OFF -DCMAKE_INSTALL_PREFIX=$install_dir"
  eval "CC=$TRUST_cc_BASE CXX=$TRUST_CC_base FC=$TRUST_F77_BASE cmake ../tfel-TFEL-$mfront_version -DCMAKE_BUILD_TYPE=Release -Denable-reference-doc=OFF -Denable-website=OFF -DCMAKE_INSTALL_PREFIX=$install_dir &>> $source_dir/build-tfel-TFEL-$mfront_version.LOG"
  ret=$?
  if ((ret)); then
     echo "Error in configuring Tfel/MFront, see file $source_dir/build-tfel-TFEL-$mfront_version.LOG"
     exit 1
  fi

  np=`nproc 2> /dev/null`
  if [ ! $np ]; then
    echo "make"
    eval "make &>> $source_dir/build-tfel-TFEL-$mfront_version.LOG"
  else
    echo "make with $np processes"
    eval "make -j $np &>> $source_dir/build-tfel-TFEL-$mfront_version.LOG"
  fi
  ret=$?
  if ((ret)); then
     echo "Error in building Tfel/MFront, see file $source_dir/build-tfel-TFEL-$mfront_version.LOG"
     exit 1
  fi

  echo "make install"
  eval "make install &>> $source_dir/build-tfel-TFEL-$mfront_version.LOG"
  ret=$?
  if ((ret)); then
     echo "Error in installing Tfel/MFront, see file $source_dir/build-tfel-TFEL-$mfront_version.LOG"
     exit 1
  fi

  cd $current_path
  rm -rf $build_dir
  echo " "
}

function compile_mfront_libraries
{
  current_path=$PWD
  
  echo "Build libraries for available material models in $current_path/share/Mfront"
  export PATH=${current_path}/local/tfel/bin:$PATH
  export LD_LIBRARY_PATH=${current_path}/local/tfel/lib:$LD_LIBRARY_PATH
  echo "Mfront version is:" 
  eval "mfront --version"
  if ((ret)); then
    echo "Error with Tfel/Mfront installation, try to re-run configure with environment variable TRIOCFD_USE_MFRONT set to 1"
    exit 1
  fi

  [[ ! -d share/Mfront_material_libraries ]] && mkdir share/Mfront_material_libraries
  cd share/Mfront_material_libraries

  for matmodel in $current_path/share/Mfront/*.mfront ; do
    echo "---> Compiling material model: "$matmodel
    matname=$(basename -- "$matmodel")
    matname="${matname%.*}"

    [[ ! -d $matname ]] && mkdir $matname
    cd $matname
    eval "mfront --build --interface=generic $matmodel &> compile-$matname.LOG"
    ret=$?
    if ((ret)); then
      echo "Error in compiling Mfront material model $matmodel, see file $current_path/share/Mfront_material_libraries/$matname/compile-$matname.LOG"
      exit 1
    else
      echo "---> OK"
    fi
    cd ..
  done

  echo " "
  cd $current_path
}

# ------------------------------------------------------------------------------ 
# Beginnig of the script
# ------------------------------------------------------------------------------ 


if [ ! -f build/html/index.html ]
then
 mkdir -p build/html/
 echo "<BR><BR>
Doxygen documentation has not been yet generated!<BR><BR>
To generate it, run :<BR>
 make doxygen" > build/html/index.html
fi
sed "s/TRUSTV/$TRUST_VERSION/" share/doc_src/index.html.in > index.html
sed -i "s?TRUSTR?$TRUST_ROOT?g" index.html

chmod ugo+x share/bin/triocfd
echo "export PATH=\${project_directory}/share/bin:\$PATH
complete -F _trust triocfd" >> env_TrioCFD.sh
echo "export PATH=\${project_directory}/share/bin:\$PATH
complete -F _trust triocfd" >> full_env_TrioCFD.sh

# --------------------------------
# For PyTools in IJK : 
# --------------------------------
if [ -d "${project_directory}/share/PyTools" ]
then
  export project_directory=$PWD
  for env in ${project_directory}/env_TrioCFD.sh
  do
     for path in share/PyTools
     do
         if [ -d ${project_directory}/$path ]; then
             # test existence de l'environnement virtuel
             if [ -d ${project_directory}/$path/venv ]; then
                 python_version=`python --version | sed 's/ //g' | sed 's/Python//g'`
                 venv_version=`grep ^version ${project_directory}/$path/venv/pyvenv.cfg | sed 's/version = //g'`
                 echo "trust python version is : " $python_version
                 echo "current venv python version is : " $venv_version
                 if [ $python_version = $venv_version ]; then
                      echo "venv for PyTools already set; you can use it after : source env_for_PyTools.sh"
                 else
                     rm -rf ${project_directory}/$path/venv && fully_prepare_venv $path
                 fi
             else
                 echo "Creating venv for PyTools..." 
                 fully_prepare_venv $path
             fi
         else
             ls ${project_directory}/$path
             echo ${project_directory}/$path
             echo "Info : PyTools is not linked. You wont be able to run some fiches calling libraries from PyTools"
         fi
     done
     echo "echo \"Optionnally: source ${project_directory}/env_for_PyTools.sh\"" >> $env
     for path in share/bin
     do
        [ -d ${project_directory}/$path ] && grep "$path" $env 1>/dev/null 2>&1 || echo "export PATH=\${project_directory}/$path:\$PATH" >> $env
     done
  done
fi

# --------------------------------
# For Tfel/Mfront : 
# --------------------------------
if [ $TRIOCFD_USE_MFRONT ]; then
  export project_directory=$PWD

  [[ -z ${BUILD_MFRONT_LIBRARIES+x} ]] && export BUILD_MFRONT_LIBRARIES=1 
  echo " "
  if [ ! $TRIOCFD_MFRONT_VERSION ]; then 
   # Default version for Tfel/Mfront
   TRIOCFD_MFRONT_VERSION="4.2.3"
  fi

  echo "Install Tfel/Mfront version $TRIOCFD_MFRONT_VERSION"
  install_mfront $TRIOCFD_MFRONT_VERSION
fi
if [ -d ${project_directory}/local/tfel ]; then
  echo "export TRIOCFD_USE_MFRONT=1" >> env_TrioCFD.sh
  echo "export LD_LIBRARY_PATH=\${project_directory}/local/tfel/lib:\$LD_LIBRARY_PATH" >> env_TrioCFD.sh
  echo "export TRIOCFD_USE_MFRONT=1" >> full_env_TrioCFD.sh
  echo "export LD_LIBRARY_PATH=\${project_directory}/local/tfel/lib:\$LD_LIBRARY_PATH" >> full_env_TrioCFD.sh
fi
if [ "$BUILD_MFRONT_LIBRARIES" == "1" ]; then compile_mfront_libraries
else
  if [ -d ${project_directory}/share/Mfront_material_libraries ]; then
    echo "Remove 'Mfront_material_libraries' directory"
    rm -rf ${project_directory}/share/Mfront_material_libraries
  fi
fi

exit 0

