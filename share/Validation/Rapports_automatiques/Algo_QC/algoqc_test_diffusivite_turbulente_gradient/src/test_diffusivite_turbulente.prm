Parameters {
	Title "Validation de l'operateur de diffusion turbulente de la temp\'erature"
	Author "Dorian Dupuy"
	VersionTrio_U 1.7.4
 	TestCase test_small test_diffusivite_turbulente.data
 	TestCase test_big test_diffusivite_turbulente.data
	ExtraUsedFile */instructions.py
}

Chapter {
 
  	Title "Cas test_diffusivite_turbulente" 

Description "\latex_(\input{../description_cas.tex}\latex_)"

	visu {
		nb_img_without_newline 2
		Description "simu_div_lambda_grad_t"
		cycles -1
		Instruction_visit exec(open("test_big/instructions.py").read())
                origine instruction

		pseudocolor test_big/test_diffusivite_turbulente_lata_1.sauv.lata simu_div_lambda_grad_t 
		Operator Slice2D_Y 0.5 0.5 0.5
		Width 7cm
	}
	visu {
		nb_img_without_newline 2
		Description "ana_div_lambda_grad_t"
		cycles -1
		Instruction_visit exec(open("test_big/instructions.py").read())
                origine instruction

		pseudocolor test_big/test_diffusivite_turbulente_lata_1.sauv.lata ana_div_lambda_grad_t 
		Operator Slice2D_Y 0.5 0.5 0.5
		Width 7cm
	}
	visu {
		nb_img_without_newline 2
		Description "error_div_lambda_grad_t"
		cycles -1
		Instruction_visit exec(open("test_big/instructions.py").read())
                origine instruction

		pseudocolor test_big/test_diffusivite_turbulente_lata_1.sauv.lata error_div_lambda_grad_t 
		Operator Slice2D_Y 0.5 0.5 0.5
		Width 7cm
	}

	Figure {
		Title_figure "Profil suivant z a x=y=0.5"
		nb_img_without_newline 2
		LabelX "z"
		LabelY "div_lambda_grad_t"
		include_description_curves 0
		legend bottom right

		Curve {
			legend "simu_div_lambda_grad_t"
			file test_big/simu_div_lambda_grad_t0000.curve
		}
		Curve {
			legend "ana_div_lambda_grad_t"
			file test_big/ana_div_lambda_grad_t0000.curve
		}
		Curve {
			legend "error_div_lambda_grad_t"
			file test_big/error_div_lambda_grad_t0000.curve
		}
		Width 14cm
	}

}

Chapter {
 
  	Title "smaller case for NR tests" 

Description "error should be slightly bigger"

	visu {
		nb_img_without_newline 2
		Description "simu_div_lambda_grad_t"
		cycles -1
		Instruction_visit exec(open("test_small/instructions.py").read())
