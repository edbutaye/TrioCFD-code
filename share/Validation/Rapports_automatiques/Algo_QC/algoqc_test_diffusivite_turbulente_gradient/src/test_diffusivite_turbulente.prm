		Curve {
			legend "simu_div_lambda_grad_t"
			file test_small/simu_div_lambda_grad_t0000.curve
		}
		Curve {
			legend "ana_div_lambda_grad_t"
			file test_small/ana_div_lambda_grad_t0000.curve
		}
		Curve {
			legend "error_div_lambda_grad_t"
			file test_small/error_div_lambda_grad_t0000.curve
