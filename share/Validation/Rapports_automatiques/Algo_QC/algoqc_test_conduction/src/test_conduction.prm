Parameters {
	Title "Validation de l'operateur de conduction"
	Author "Dorian Dupuy"
	VersionTrio_U 1.7.4
 	TestCase test_conduction test_conduction.data
 	TestCase test_small test_conduction.data
	ExtraUsedFile */instructions.py
}

Chapter {
 
  	Title "Cas test_conduction" 

Description "\latex_(\input{../description_cas.tex}\latex_)"

	visu {
		nb_img_without_newline 2
		Description "simu_div_lambda_grad_t"
		cycles -1
		Instruction_visit exec(open("test_conduction/instructions.py").read())
                origine instruction

		pseudocolor test_conduction/test_conduction_lata_1.sauv.lata simu_div_lambda_grad_t 
		Operator Slice2D_Y 0.5 0.5 0.5
		Width 7cm
	}
	visu {
		nb_img_without_newline 2
		Description "ana_div_lambda_grad_t"
		cycles -1
		Instruction_visit exec(open("test_conduction/instructions.py").read())
                origine instruction

		pseudocolor test_conduction/test_conduction_lata_1.sauv.lata ana_div_lambda_grad_t 
		Operator Slice2D_Y 0.5 0.5 0.5
		Width 7cm
	}
	visu {
		nb_img_without_newline 2
		Description "error_div_lambda_grad_t"
		cycles -1
		Instruction_visit exec(open("test_conduction/instructions.py").read())
                origine instruction

		pseudocolor test_conduction/test_conduction_lata_1.sauv.lata error_div_lambda_grad_t 
		Operator Slice2D_Y 0.5 0.5 0.5
		Width 7cm
	}

	Figure {
		Title_figure "Profil suivant z a x=y=0.5"
		nb_img_without_newline 2
		LabelX "z"
		LabelY "div_lambda_grad_t"
		include_description_curves 0
		legend bottom right

		Curve {
			legend "simu_div_lambda_grad_t"
			file test_conduction/simu_div_lambda_grad_t0000.curve
		}
		Curve {
			legend "ana_div_lambda_grad_t"
			file test_conduction/ana_div_lambda_grad_t0000.curve
		}
		Curve {
			legend "error_div_lambda_grad_t"
			file test_conduction/error_div_lambda_grad_t0000.curve
		}
		Width 14cm
	}

}
Chapter {
 
  	Title "Smaller test for NR (not fully converged)" 


	visu {
		nb_img_without_newline 2
		Description "simu_div_lambda_grad_t"
		cycles -1
		Instruction_visit exec(open("test_small/instructions.py").read())
                origine instruction

		pseudocolor test_small/test_conduction_lata_1.sauv.lata simu_div_lambda_grad_t 
		Operator Slice2D_Y 0.5 0.5 0.5
		Width 7cm
	}
	visu {
		nb_img_without_newline 2
		Description "ana_div_lambda_grad_t"
		cycles -1
		Instruction_visit exec(open("test_small/instructions.py").read())
                origine instruction

		pseudocolor test_small/test_conduction_lata_1.sauv.lata ana_div_lambda_grad_t 
		Operator Slice2D_Y 0.5 0.5 0.5
		Width 7cm
	}
	visu {
		nb_img_without_newline 2
		Description "error_div_lambda_grad_t"
		cycles -1
		Instruction_visit exec(open("test_small/instructions.py").read())
                origine instruction

		pseudocolor test_small/test_conduction_lata_1.sauv.lata error_div_lambda_grad_t 
		Operator Slice2D_Y 0.5 0.5 0.5
		Width 7cm
	}

	Figure {
		Title_figure "Profil suivant z a x=y=0.5"
		nb_img_without_newline 2
		LabelX "z"
		LabelY "div_lambda_grad_t"
		include_description_curves 0
		legend bottom right

		Curve {
			legend "simu_div_lambda_grad_t"
			file test_small/simu_div_lambda_grad_t0000.curve
		}
		Curve {
			legend "ana_div_lambda_grad_t"
			file test_small/ana_div_lambda_grad_t0000.curve
		}
		Curve {
			legend "error_div_lambda_grad_t"
			file test_small/error_div_lambda_grad_t0000.curve
		}
		Width 14cm
	}

}

