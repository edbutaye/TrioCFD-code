dimension 3
Probleme_FTD_IJK pb

Domaine_IJK DOM
Lire DOM
{
  nbelem 48 48 24
  size_dom 0.006 0.006 0.003
  perio 1 1 0
  nproc 1 1 1
  ijk_splitting_ft_extension 20
}

schema_euler_explicite_IJK sch

lire sch 
{
  tinit 0.0
  nb_pas_dt_max 30
  timestep 3.31e-4
  timestep_facsec 1
  dt_sauvegarde 99999999

}

option_ijk { check_divergence }
IJK dis

associer sch pb
associer DOM pb
Discretize pb dis



lire pb
{
  Solved_Equations
  {
    Navier_Stokes_FTD_IJK hydraulique
    IJK_interfaces interfaces
  }


  Fluide_Diphasique_IJK
  {
    # Give a number for each phase #
    fluide0 Fluide_Incompressible # Vapour #
    {
      mu  Champ_Uniforme 1 1e-3
      rho Champ_Uniforme 1 600
    }
    fluide1 Fluide_Incompressible # Liquid #
    {
      mu  Champ_Uniforme 1 1e-3
      rho Champ_Uniforme 1 1000
    }
    # Surface tension #
    sigma Champ_Uniforme 1 0.07

    # Gravity field #
    gravite Champ_Uniforme 3 -9.81 0. 0.
  }


  interfaces
  {
    # Soit un fichier genere externe #
    # Choix1 #
    fichier_reprise_interface ../../init.sauv.lata
    timestep_reprise_interface 1
    # lata_meshname   FTMESH #
    # Bary et lissage #
    remaillage_ft_ijk {
      nb_iter_barycentrage 1
      relax_barycentrage 1
      nb_iter_correction_volume 6
      lissage_courbure_iterations_systematique 0
    }
  }

  hydraulique
  {
    Boundary_Conditions {
      bctype_kmin Paroi
      bctype_kmax Paroi
    }


  multigrid_solver {
    solver_precision mixed
    $coarsen_operators
    $mycoarsen
    ghost_size 1
    pre_smooth_steps 1 10
    smooth_steps 1 10
    relax_jacobi 1 0.7
    solveur_grossier GCP { seuil 1e-10  precond ssor { omega 1.5 } impr }
    seuil 1e-9
    nb_full_mg_steps 2 4 1
    impr
  }

  fichier_reprise_vitesse ../../init.sauv.lata
  timestep_reprise_vitesse 1
  expression_p_init 0.
  expression_vx_init 0.
  expression_vy_init 0.
  expression_vz_init 0.
  }
  {
    
  }
  post_processing 
  {
    format LATA
    
    nb_pas_dt_post 100000
  nb_pas_dt_post_stats_bulles 1000000
  nb_pas_dt_post_stats_plans 100000
  t_debut_statistiques 0.0
    fields 
    {
       dPd faces
    }

  }
}
solve pb
END

IJK_FT_double
{


  # LECTURE DES INTERFACES DANS UN FICHIER LATA #


}

Fin
