# PARALLEL ONLY 8 #
dimension 3
Probleme_FTD_IJK pb

system " tar -xzf maillage_ijk.tar.gz " 

Domaine_IJK DOM
Lire DOM
{
  nbelem 32 32 32
  size_dom 0.00475 0.00475 0.00475
  perio 1 1 1
  # DEBUT MAILLAGE #
  nproc 1 1 1
  # FIN MAILLAGE #
  # DEBUT LECTURE #
  nproc 2 2 2 
  # FIN LECTURE #
  ijk_splitting_ft_extension 20  # To be checked.. #
}

Schema_RK3_IJK sch
lire sch
{
  tinit 0.0
  timestep 0.9e-4
  timestep_facsec 1.0
  nb_pas_dt_max 1000
  dt_sauvegarde 100000
  cfl 1.0
  fo  1.0
  oh  1.0
}

IJK dis

associer sch pb
associer DOM pb
Discretize pb dis

Option_IJK
{
  check_divergence
  # disable_diphasique #
}

lire pb
{
  SOLVED_EQUATIONS
  {
    Navier_Stokes_FTD_IJK hydraulique
    ijk_interfaces interf
  }

  Fluide_Diphasique_IJK
  {
    # Give a number for each phase #
    # vapeur #
    fluide0 Fluide_Incompressible
    {
        mu  Champ_Uniforme 1 0.0020291187748882017
        rho Champ_Uniforme 1 44.0
    }
    # liquide #
    fluide1 Fluide_Incompressible
    {
        mu  Champ_Uniforme 1 0.040582375497764035
        rho Champ_Uniforme 1 880.0
    }
    # Surface tension #
    sigma   Champ_Uniforme 1 0.031153874425382942

    # Gravity field #
    gravite Champ_Uniforme 3 -9.81 0. 0.
  }

  hydraulique
  {
    vol_bulle_monodisperse 3.5895433333333366e-09
    velocity_convection_op Centre
    velocity_diffusion_op Laminar_transpose
    Boundary_Conditions
    {
      bctype_kmin perio
      bctype_kmax perio
    }

    multigrid_solver
    {
      solver_precision mixed
      coarsen_operators 0
      # Coarsen_Operator_Uniform {  } #
      ghost_size 1
      pre_smooth_steps 1 7
      smooth_steps 1 7
      relax_jacobi 1 0.7
      solveur_grossier GCP { seuil 1e-10  precond ssor { omega 1.5 }  }
      seuil 1e-8
      nb_full_mg_steps 2 20 1
    }

    terme_force_init 8358.06114
    # compute_force_init #
    # expression_derivee_force 0. #
    # refuse_patch_conservation_QdM_RK3_source_interf #
    # REPRISE #
    # nom_reprise SWITCH/diph_chgt.sauv #
    # timestep_reprise_vitesse 1 #
    expression_vx_init -0.0335
    expression_vy_init 0.
    expression_vz_init 0.
	}

  # LECTURE DES INTERFACES DANS UN FICHIER LATA #
  interf
  {
    terme_gravite rho_g
    fichier_reprise_interface init.lata
    timestep_reprise_interface       1
    lata_meshname   INTERFACES
    remaillage_ft_ijk
    {
      pas_remaillage 1e-6
      nb_iter_barycentrage 1
      relax_barycentrage 1.00000000000000000e+00
      critere_arete 3.49999999999999978e-01
      seuil_dvolume_residuel 0.00000000000000000e+00
      nb_iter_correction_volume 6
      nb_iter_remaillage 6
      facteur_longueur_ideale 7.50000000000000000e-01
      lissage_courbure_coeff -2.50000000000000014e-02
      lissage_courbure_iterations_systematique 5
      lissage_courbure_iterations_si_remaillage 10
    }
  # follow_colors #
  }
  {
  } 
  post_processing 
  {
  format LATA
  # fichier RESU_ijk/bulle_isolee_ijk #
  nb_pas_dt_post 10000
  nb_pas_dt_post_stats_bulles 10
  # nb_pas_dt_post_stats_plans 10 #
  t_debut_statistiques 0.0

  fields
  {
    INDICATRICE elem
    VELOCITY elem
  }
  interfaces interf {
        COURBURE som
    }
  }
}
solve pb

Fin
