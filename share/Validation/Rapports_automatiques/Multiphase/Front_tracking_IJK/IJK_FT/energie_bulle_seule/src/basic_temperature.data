dimension 3
Probleme_FTD_IJK pb

Domaine_IJK DOM
Lire DOM
{
  nbelem 32 16 16
  size_dom 0.005 0.0025 0.0025
  perio 1 1 1
  nproc 1 1 1
  ijk_splitting_ft_extension 5
}

schema_euler_explicite_IJK sch

lire sch 
{
  tinit 0.0
  timestep 1
  timestep_facsec 0.5 # a diminuer #
  
  nb_pas_dt_max 1000
  cfl 1.
  fo 1.
  dt_sauvegarde 1000000

}

option_ijk {  }
IJK dis

associer sch pb
associer DOM pb
Discretize pb dis

lire pb
{
  Solved_Equations
  {
    Navier_Stokes_FTD_IJK hydraulique
    IJK_interfaces interf
    IJK_Thermals thermals
  }


  # Properties from Panda et al. #
  Fluide_Diphasique_IJK
  {
    # Give a number for each phase #
    fluide0 Fluide_Incompressible # Vapour #
    {
      mu  Champ_Uniforme 1 1.
      rho Champ_Uniforme 1 10.
      lambda Champ_Uniforme 4 3 3 3 3
      cp Champ_Uniforme 4 100 100 100 100
    }
    fluide1 Fluide_Incompressible # Liquid #
    {
      mu  Champ_Uniforme 1 1.
      rho Champ_Uniforme 1 10.
      lambda Champ_Uniforme 4 6 6 6 6
      cp Champ_Uniforme 4 10 10 10 10
    }
    
    # Surface tension #
    sigma Champ_Uniforme 1 0.0

    # Gravity field #
    gravite Champ_Uniforme 3 0. 0. 0.
  }

  interf
  {
    fichier_reprise_interface pre_run.lata
    timestep_reprise_interface       1
    # lata_meshname   FTMESH #
    # Bary et lissage # 
    remaillage_ft_ijk {
     pas_remaillage 2.5e7
     nb_iter_barycentrage 0
     relax_barycentrage 0
     critere_arete 3.49999999999999978e-01
     seuil_dvolume_residuel 0.00000000000000000e+00
     nb_iter_correction_volume 0
     nb_iter_remaillage 0
     facteur_longueur_ideale 0.75
     equilateral 1
     lissage_courbure_coeff -2.5e-02
     lissage_courbure_iterations_systematique 0   # TESTER 20? #
     lissage_courbure_iterations_si_remaillage 0
     }
     terme_gravite rho_g
  
  }

  hydraulique
  {
    Boundary_Conditions
    {
      bctype_kmin perio
      bctype_kmax perio
    }

  disable_convection_qdm
  disable_diffusion_qdm
  disable_solveur_poisson
  
  vol_bulle_monodisperse 4.188790204786391e-9 # r=1mm #
    
  multigrid_solver {
    solver_precision mixed
    coarsen_operators 0
      # Coarsen_Operator_Uniform { } #
      # Coarsen_Operator_Uniform { } #
    ghost_size 1
    pre_smooth_steps 1 10
    smooth_steps 1 10
    relax_jacobi 1 0.7
    solveur_grossier GCP { seuil 1e-8  precond ssor { omega 1.5 } impr }
    seuil 1e-8
    nb_full_mg_steps 2 4 1
    impr
  }

  expression_vx_init 1.0
  expression_vy_init 0.0
  expression_vz_init 0.0
 
    # TEMPS
    expression_derivee_force 0.0
    TEMPS #
  }
  thermals
  {
    ONEFLUID
    {
    Boundary_Conditions 
    {
        bctype_kmin Perio
        bctype_kmax Perio
    }
    diff_temperature_negligible

    expression_T_init 1.-ff      

    } ,
    ONEFLUID
    {
    Boundary_Conditions 
    {
        bctype_kmin Perio
        bctype_kmax Perio
    }
    conv_temperature_negligible

    expression_T_init 1.-ff   

    } ,
    ONEFLUID
    {
    Boundary_Conditions 
    {
        bctype_kmin Perio
        bctype_kmax Perio
    }
    expression_T_init 1.-ff      

    } ,
    ONEFLUID
    {
    Boundary_Conditions 
    {
        bctype_kmin Perio
        bctype_kmax Perio
    }
    expression_T_init 293.0+x/0.005*80.

    }
  }
  {
    nom_sauvegarde algo_ft.sauv
    
  }
  post_processing 
  {
    format LATA
    nb_pas_dt_post 10 


    fields 
    {
       INDICATRICE elem
       Pressure_RHS elem
       VELOCITY FACES
       Velocity_FT FACES
       TEMPERATURE_0 ELEM
       TEMPERATURE_1 ELEM
       TEMPERATURE_2 ELEM
       TEMPERATURE_3 ELEM
    }
    interfaces interf
    {
    }


  }
}
solve pb
Fin

















IJK_FT_double
{


  

  


 energie
  { 
    {
    diff_temp_negligible
    expression_T_init 1.-ff        

    }
     ,
    {
    conv_temperature_negligible
    expression_T_init 1.-ff        

    }
     ,
    {

    expression_T_init 1.-ff         

    }
     ,
    {

    expression_T_init 293.0+x/0.005*80.

    }
  }

Fin
