# PARALLEL ONLY 2 # 

dimension 2

Pb_hydraulique_ALE pb
Domaine_ALE dom

# BEGIN MESH 
Lire_MED { 
   domain dom 
   file ../MeshWithSquare.med 
}
END MESH #

# BEGIN PARTITION
Partition dom
{
	Partition_tool metis { Nb_parts 2 }
	Larg_joint 2
	zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER #
Scatter DOM.Zones dom
# END SCATTER #

# For the Arbitrary Lagrangian-Eulerian framework: block to indicate the number of mobile
boundaries of the domain and specify the speed that must be imposed on them. #
Imposer_vit_bords_ALE dom
{
	4 # number of mobile boundaries #
	SquareSouth Champ_front_ALE 2 (5332.1060948531*t^14-32298.6022288094*t^13+82536.4975918952*t^12-113601.598522952*t^11+87092.7829977197*t^10-30701.3161138279*t^9-4149.8806731801*t^8+9018.0763311767*t^7-4116.7644578227*t^6+1021.4242442502*t^5-143.2563722683*t^4+11.9491505207*t^3-0.4279584487*t^2+0.009455793*t)*(t<0.999999999)+0.9995388994919747*(t>1) 0.   # name and speed of the border #
	SquareEast Champ_front_ALE 2 (5332.1060948531*t^14-32298.6022288094*t^13+82536.4975918952*t^12-113601.598522952*t^11+87092.7829977197*t^10-30701.3161138279*t^9-4149.8806731801*t^8+9018.0763311767*t^7-4116.7644578227*t^6+1021.4242442502*t^5-143.2563722683*t^4+11.9491505207*t^3-0.4279584487*t^2+0.009455793*t)*(t<0.999999999)+0.9995388994919747*(t>1) 0.   # name and speed of the border #
	SquareNorth Champ_front_ALE 2 (5332.1060948531*t^14-32298.6022288094*t^13+82536.4975918952*t^12-113601.598522952*t^11+87092.7829977197*t^10-30701.3161138279*t^9-4149.8806731801*t^8+9018.0763311767*t^7-4116.7644578227*t^6+1021.4242442502*t^5-143.2563722683*t^4+11.9491505207*t^3-0.4279584487*t^2+0.009455793*t)*(t<0.999999999)+0.9995388994919747*(t>1) 0.   # name and speed of the border #	
	SquareWest Champ_front_ALE 2 (5332.1060948531*t^14-32298.6022288094*t^13+82536.4975918952*t^12-113601.598522952*t^11+87092.7829977197*t^10-30701.3161138279*t^9-4149.8806731801*t^8+9018.0763311767*t^7-4116.7644578227*t^6+1021.4242442502*t^5-143.2563722683*t^4+11.9491505207*t^3-0.4279584487*t^2+0.009455793*t)*(t<0.999999999)+0.9995388994919747*(t>1) 0.   # name and speed of the border #
}


# Solver used to solve the system giving the moving mesh velocity #
Solver_moving_mesh_ALE dom { PETSC GCP { precond ssor { omega 1.5 } seuil 1e-7 impr }  } 

# I select a discretization #
VEFPreP1B ma_discretisation



Schema_euler_explicite_ALE mon_schema 
Read mon_schema
{
	tinit 0
	tmax 1.
	dt_max 5e-4
	dt_impr 5.e-4
	dt_sauv 100
	seuil_statio 1.e-8 
	nb_pas_dt_max 3
}




# Association between the different objects #
Associate pb dom
Associate pb mon_schema
Discretize pb ma_discretisation

Domaine_ALE surface_SquareEast
Domaine_ALE surface_SquareWest

Read pb
{
   
   fluide_incompressible {
    	mu Champ_Uniforme 1 0.02
   	rho Champ_Uniforme 1 1
   }
   
   	Navier_Stokes_standard_ALE
	{
		# Pressure matrix solved with #
 		solveur_pression petsc cholesky { }
		# Two operators are defined #
		convection {  ALE { amont } } # A convective scheme for ALE framework : choice between: amont and muscl #
		diffusion { }
		# Uniform initial condition for velocity #
		initial_conditions {
			vitesse Champ_Uniforme 2 0.00001 0.
			}
		# Boundary conditions #
		boundary_conditions {
			SquareSouth frontiere_ouverte_vitesse_imposee_ALE Champ_front_ALE 2 (5332.1060948531*t^14-32298.6022288094*t^13+82536.4975918952*t^12-113601.598522952*t^11+87092.7829977197*t^10-30701.3161138279*t^9-4149.8806731801*t^8+9018.0763311767*t^7-4116.7644578227*t^6+1021.4242442502*t^5-143.2563722683*t^4+11.9491505207*t^3-0.4279584487*t^2+0.009455793*t)*(t<0.999999999)+0.9995388994919747*(t>1) 0.   # name and speed of the border #
			SquareEast frontiere_ouverte_vitesse_imposee_ALE Champ_front_ALE 2 (5332.1060948531*t^14-32298.6022288094*t^13+82536.4975918952*t^12-113601.598522952*t^11+87092.7829977197*t^10-30701.3161138279*t^9-4149.8806731801*t^8+9018.0763311767*t^7-4116.7644578227*t^6+1021.4242442502*t^5-143.2563722683*t^4+11.9491505207*t^3-0.4279584487*t^2+0.009455793*t)*(t<0.999999999)+0.9995388994919747*(t>1) 0.   # name and speed of the border #
			SquareNorth frontiere_ouverte_vitesse_imposee_ALE Champ_front_ALE 2 (5332.1060948531*t^14-32298.6022288094*t^13+82536.4975918952*t^12-113601.598522952*t^11+87092.7829977197*t^10-30701.3161138279*t^9-4149.8806731801*t^8+9018.0763311767*t^7-4116.7644578227*t^6+1021.4242442502*t^5-143.2563722683*t^4+11.9491505207*t^3-0.4279584487*t^2+0.009455793*t)*(t<0.999999999)+0.9995388994919747*(t>1) 0.   # name and speed of the border #
			SquareWest frontiere_ouverte_vitesse_imposee_ALE Champ_front_ALE 2 (5332.1060948531*t^14-32298.6022288094*t^13+82536.4975918952*t^12-113601.598522952*t^11+87092.7829977197*t^10-30701.3161138279*t^9-4149.8806731801*t^8+9018.0763311767*t^7-4116.7644578227*t^6+1021.4242442502*t^5-143.2563722683*t^4+11.9491505207*t^3-0.4279584487*t^2+0.009455793*t)*(t<0.999999999)+0.9995388994919747*(t>1) 0.   # name and speed of the border #
		      	Wall  	paroi_fixe
		}
	}
	
	Post_processing
	{
		Definition_champs
		{
				# Creation of the 0D field: surface averaged pressure on the boundary wall #
				averaged_pressure_SquareEast Reduction_0D { 
					methode moyenne 
					source Extraction { 
							domaine surface_SquareEast nom_frontiere SquareEast methode trace  
							source RefChamp { Pb_champ pb pression } 
                                        }
                                }
				averaged_pressure_SquareWest Reduction_0D { 
					methode moyenne 
					source Extraction { 
							domaine surface_SquareWest nom_frontiere SquareWest methode trace  
							source RefChamp { Pb_champ pb pression } 
                                        }
                                }

				drag_coef_pressure_comp Transformation { 
					methode formule expression 1 2*(averaged_pressure_SquareEast-averaged_pressure_SquareWest) 
					sources_reference { averaged_pressure_SquareWest , averaged_pressure_SquareEast }  
				 } 
		}


		# Probes #
		Probes
		{
			sonde_drag_coef_pressure_comp drag_coef_pressure_comp periode 0.0005 numero_elem_sur_maitre 1	

			sonde_pression_segment_h1   pression periode 0.5 segment 100 0. 1.5  10. 1.5
			sonde_pression_segment_h2    pression periode 0.5 segment 100 0. 2.5  10. 2.5
			sonde_pression_segment_h3    pression periode 0.5 segment 100 0. 3.5  10. 3.5
			sonde_pression_segment_v1    pression periode 0.5 segment 100 0.8 0.  1. 5.
			sonde_pression_segment_v2    pression periode 0.5 segment 100 2.5 0.  2.5 5.

	
		}
		
		# Fields #
		format lml
		fields dt_post 1e3
		{
			pression_pa som
			vitesse som
			ALEMeshVelocity som
			ALEMeshTotalDisplacement som
		}


	}
        resume_last_time pdi Cas.sauv 
        Sauvegarde_simple pdi Cas.sauv
}
EcritureLectureSpecial 0
# The problem is solved with #
Solve pb

# Not necessary keyword to finish #
End
 
