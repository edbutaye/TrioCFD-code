# Quasi-compressible + RANS + Implicit scheme on VEF mesh #
dimension 3
Pb_Thermohydraulique_Turbulent_QC pb_fluide

Domaine dom_fluide

# BEGIN MESH #
lire_fichier dom_fluide mesh.geom
/* raffiner_isotrope dom_fluide */
# END MESH #

VEFPreP1B dis


# BEGIN PARTITION
Partition dom_fluide
{
    Partition_tool metis { Nb_parts 3 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom_fluide
END SCATTER #



Scheme_euler_implicit sch
Read sch
{
    nb_pas_dt_max 10
    tinit 0
    tmax 432000
# tcpumax 335.5 #
    dt_min   1.e-5
    dt_max 10
# dt_start dt_fixe  1.e-5 #
    dt_impr 1.e-4
    dt_sauv 1000
    seuil_statio -1
    solveur implicite
    {
# seuil_convergence_solveur 1e-6 #
        solveur petsc_gpu gmres { precond diag { } rtol 1.e-10 impr controle_residu 1 } 
    }
    Facsec 10
    facsec_max 1000
    periode_sauvegarde_securite_en_heures 11
}

Associate pb_fluide dom_fluide
Associate pb_fluide sch
Discretize pb_fluide dis


Read pb_fluide
{

    fluide_quasi_compressible {
        gravite champ_uniforme 3  0. 0 -9.81
        pression 210e+5
        mu Champ_Uniforme 1 2.0e-5
        lambda Champ_Uniforme 1 41e-3
        loi_etat gaz_parfait_QC
        {
            Prandtl 1.5731707317073171382
            Cp 3225.
            gamma 1.19
        }
        traitement_pth CONSERVATION_MASSE
    }

    Navier_Stokes_Turbulent_QC
    {
        solveur_pression AMG GCP { atol 1.e-12 impr }
        convection { ef_stab { alpha 0.5 } }
        diffusion { }
        initial_conditions { vitesse champ_uniforme  3 0. 0. 0. }
        boundary_conditions
        {
            paroi_big paroi_fixe
            bas  paroi_fixe
            Group_1 frontiere_ouverte_rho_u_impose Champ_front_fonc_t 3 0. 0. -322.0819376449369
        }
        modele_turbulence K_Epsilon {
            Transport_equation Transport_K_Epsilon
            {
                convection { ef_stab { alpha 0.5 } }
                diffusion { }
                boundary_conditions
                {
                    paroi_big paroi
                    Group_1 frontiere_ouverte_K_eps_impose Boundary_field_uniform_keps_from_ud { U -4.07 D 0.0064 }
                    bas paroi
                }
                conditions_initiales
                {
                    k_Eps Champ_uniforme 2 0. 0.
                }

            }
            Prandtl_K 1
            Prandtl_Eps 1.3
            turbulence_paroi Loi_standard_hydr eps_min 1.e-7 eps_max 100 nut_max 0.1 quiet
        }
    }

    Convection_Diffusion_Chaleur_Turbulent_QC
    {
        Modele_Turbulence prandtl { turbulence_paroi loi_standard_hydr_scalaire }
        diffusion { }
        convection { ef_stab { alpha 0.5 } }
        boundary_conditions
        {
            paroi_big    Paroi_echange_externe_impose H_IMP champ_front_fonc_xyz 1 3 T_ext champ_front_fonc_xyz 1 273.15+(z_GT_28)*(56.9-0.02*z)+(z_LE_28)*(47.94+3/10*z)
            Group_1  frontiere_ouverte_temperature_imposee  champ_front_uniforme 1 326.05
            bas Paroi_temperature_imposee champ_front_uniforme 1 326.49
        }
        initial_conditions { temperature Champ_uniforme 1 331 }
    }

    Post_processings
    {
      lata
      {
        definition_champs
        {
            Delta transformation { methode formule expression 1 vol^(1/3) localisation elem source refChamp { Pb_champ pb_fluide volume_maille nom_source vol } }
            Moy_temp_fluide Reduction_0D { methode moyenne_ponderee sources { refChamp { Pb_champ pb_fluide temperature } } }
            ecart_relatif transformation
            {
                methode formule
                expression 1 temperature-Moy_temp_fluide
                sources
                {
                    Interpolation { localisation elem source refChamp { Pb_champ pb_fluide temperature } nom_source temperature } ,
                    Interpolation { localisation elem sources_reference { Moy_temp_fluide } nom_source Moy_temp_fluide }
                }
            }
            entree_vit  Reduction_0D { methode weighted_average source Interpolation { domaine dom_fluide_boundaries_Group_1  localisation elem source refChamp { Pb_champ pb_fluide vitesse } } }
        }

        Probes {
            sonde_moy_temp Moy_temp_fluide periode 1e-8 numero_elem_sur_maitre 0
            sonde_vit vitesse periode 0.001 segment 1000  0. 0. 0. 0. 0. 200
            sonde_temp temperature periode 0.001 segment 1000   0. 0. 0. 0. 0. 200
            sonde_pa pression_pa periode 0.001 segment 1000  0. 0. 0. 0. 0. 200
            sonde_rho masse_volumique periode 0.001 segment 1000  0. 0. 0. 0. 0. 200
            sonde_pre pression_tot periode 0.001 segment 1000   0. 0. 0. 0. 0. 200
            sonde_p pression periode 0.001 segment 1000  0. 0. 0. 0. 0. 200
            sonde_vic viscosite_turbulente periode 0.001 segment 1000  0. 0. 0. 0. 0. 200
            entree_vit   entree_vit  periode 1e-6 numero_elem_sur_maitre 0
        }

        format lata fichier QC_RANS_VEF
        Champs dt_post 1000
        {
            pression_pa elem
            pression elem
            pression_tot elem
            masse_volumique elem
            viscosite_turbulente elem
            k elem
            eps elem
            temperature elem
            y_plus elem
            vitesse elem
            Moy_temp_fluide
            ecart_relatif
            delta
        }
      }
      lml
      {
         format lml fichier QC_RANS_VEF
         Champs dt_post 1000 { pression som }
      }  
    }

    sauvegarde_simple binaire cavity_1.sauv
# Resume_last_time binaire cavity_1.sauv #

}

Solve pb_fluide

/* lata_to_med save_prec.lata condint_prec.med
lata_to_med save_fluide.lata condint_fluide.med
lata_to_med save_solide.lata condint_solide.med */

End


