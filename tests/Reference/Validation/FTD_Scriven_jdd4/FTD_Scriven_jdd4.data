# Boiling bubble simulation #
# lance_test 4 ecarts #
# PARALLEL RUNS #
dimension 2 
PrecisionGeom 1e-18
bidim_axi

domaine dom

# BEGIN MESH #
Mailler dom
{

   Pave pave1
   { 
   origine 0. 0.
   longueurs 1 1
   nombre_de_noeuds 41 41
   Facteurs 1. 1.0
   }
   {
   bord left1     X = 0.          0. <= Y <= 1
   bord right1    X = 1          0. <= Y <= 1
   bord bot1      Y = 0.          0. <= X <= 1
   bord top1      Y = 1          0. <= X <= 1
   }
  }  
transformer dom x*0.002121 y*0.002121

# END MESH #

# BEGIN PARTITION
Partition dom
{
   Partitionneur tranche { tranches 1 1 }
   Larg_joint 2
   Nom_Zones DOM
}
Fin
END PARTITION #

# BEGIN SCATTER 
Scatter ./DOM.Zones dom
 END SCATTER #
 
Probleme_FT_Disc_gen pb

Schema_Euler_explicite  sch
Lire sch
{
   tinit 0.
	nb_pas_dt_max 3
   tmax 0.13459024199383246 
   tcpumax 523.
   dt_min 1e-18
   dt_max 1.0000000000000002e-06 
   dt_impr 2.e-2
   impr_diffusion_implicite 1
   dt_sauv 0.00673
   facsec 1.
   seuil_statio 1e-12
   diffusion_implicite 0
   seuil_diffusion_implicite 1e-15
   periode_sauvegarde_securite_en_heures 4
}

Associate pb dom
Associate pb sch
VDF dis
Discretize pb dis
system "mkdir -p lata"
option_vdf { All_options } # To set the BC of pressure on the Boundary, not at the center of ghost cells! #
Lire pb
{

solved_equations
    {
        Navier_stokes_FT_disc                         hydraulique
        Transport_interfaces_FT_disc                  interf
        convection_diffusion_temperature_FT_disc  thermique
    }
    
   Fluide_diphasique
    {
        fluide1 Fluide_Incompressible # water #
        {
            mu champ_uniforme       1 2.8e-4
  	    rho champ_uniforme      1 958.37
  	    lambda champ_uniforme   1 0.679
  	    cp champ_uniforme       1 4.21e3
  	    beta_th Champ_Uniforme  1 0.0007504815417629351
        }

        fluide0 Fluide_Incompressible # vapeur #
        {
            mu champ_uniforme       1 1.227e-5
  	    rho champ_uniforme      1 0.597 
  	    lambda champ_uniforme   1 0.025
  	    cp champ_uniforme       1 2.077e3 
  	    beta_th Champ_Uniforme  1 0.002902383982248589
        }

        sigma   Champ_Uniforme 1            0. # 5.89e-2 #
        # sigma_t   Champ_Uniforme 1          1.0 #
        chaleur_latente Champ_Uniforme 1   -2.256e6
        # formule_lambda standard
        formule_rhoCp standard #
        formule_mu harmonique
    }
   hydraulique
   {
      # parametre_equation parametre_diffusion_implicite
        {
            solveur petsc gcp { precond block_jacobi_ilu { level 0 } rtol 1.e-13 impr }
        } #
      modele_turbulence null { }
      # solveur_pression GCP { precond ssor { omega 1.5 } seuil 1e-12 impr } #
      solveur_pression petsc GCP { precond ssor { omega 1.5 } atol 1e-9 impr }
      convection { quick }
      diffusion { }
      conditions_initiales { vitesse champ_uniforme 2 0. 0. }
      # conditions_initiales { vitesse Champ_Fonc_reprise binaire STEADY/steady.sauv pb vitesse last_time  } #
      projection_initiale 0
      dt_projection 1.e-10 1.e-18
      equation_interfaces_proprietes_fluide interf
      equation_temperature_mpoint thermique
      new_mass_source
       
      # -> it's a flag, when not activated, the variable is 0 #
      # when new_mass_source is used, it forces the use of the new jump(1/rho)*ai*mp as a source term in the RHS of Poisson instead of the historical div(delta_u) #
      interpol_indic_pour_dI_dt interp_modifiee # interp_ai_based #
      OutletCorrection_pour_dI_dt CORRECTION_GHOST_INDIC
      terme_gravite grad_I
      boundary_conditions 
      {
      right1   sortie_libre_rho_variable champ_front_fonc_xyz 1 0. # -958.37*9.81*(Y-0.009) cela depend de l'option terme_gravite #
      bot1     Symetrie
      top1      sortie_libre_rho_variable champ_front_uniforme 1 0.
      left1    Symetrie
      }
   }
   interf
   {
      type_indic_faces standard # interpolation to faces of indic : { STANDARD, MODIFIEE, AI_BASED } #
      # interpolation_repere_local #
      methode_interpolation_v vdf_lineaire
      methode_transport vitesse_interpolee hydraulique
      conditions_initiales { fonction x^2+(y-0.001*cos(90.0*pi/180.0))^2-0.001^2 }
      VOFlike_correction_volume 0 # Flag to activate the VOF-like volume conservation (dI/dt) #
      nb_iterations_correction_volume 0 # to get the correct dI/dt #
      nb_lissage_correction_volume 0 # To smooth the dI/dt correction to avoid pikes on the interface #
      n_iterations_distance 8
      # Bloc Remesh Best # 
      remaillage {
                    pas 1e-12
                    nb_iter_remaillage 3
                    critere_arete 0.35
                    pas_lissage 1e-12
                    relax_barycentrage 0.1
                    facteur_longueur_ideale 1.0
                    nb_iter_barycentrage 1
                    nb_iter_correction_volume 3
                    seuil_dvolume_residuel 1e-15
                    lissage_courbure_coeff -0.02
                    lissage_courbure_iterations_systematique 1
                    lissage_courbure_iterations_si_remaillage 5
      }
      # End Remesh Best #
      collisions
      {
                active
                # juric_pour_tout #
                juric_local  phase_continue 1 
                type_remaillage Juric { source_isovaleur indicatrice }
      }
      parcours_interface { Correction_Parcours_Thomas }
      boundary_conditions
      {
      bot1    Paroi_FT_disc Symetrie
      right1  Paroi_FT_disc Symetrie
      top1     Paroi_FT_disc Symetrie
      left1   Paroi_FT_disc Symetrie
      }
   }
   
   thermique
   {
      # parametre_equation parametre_diffusion_implicite
        {
            solveur petsc gcp { precond block_jacobi_ilu { level 0 } rtol 1.e-13 impr }
        } #
      # Pb quand on fait ça, il ne calcul pas le dt_stab de convection en FTD?? #
      # Parametre_equation parametre_implicite { resolution_explicite } #
      equation_interface interf
      equation_navier_stokes hydraulique
      phase 1
                stencil_width 9
		correction_gradt_ordre 0
                correction_mpoint_diff_conv_energy 3 0 0 0 # diff conv energy #
                diffusion { }
                convection { quick }
                boundary_conditions
                {
                bot1   Symetrie
                top1    frontiere_ouverte T_ext Champ_front_Uniforme 1 1.0
                right1   frontiere_ouverte T_ext Champ_front_Fonc_xyz 1 1.0
                left1    Symetrie
                }
                
              conditions_initiales { Temperature_thermique Champ_Don_lu dom 1 examplebis.rep }           
   }
   postraitement 
   {
      champs dt_post 100
      {
         indicatrice_interf
         temperature_thermique
       vitesse
       pression
       mpoint_thermique
      }
                Probes 
               {
                  T_abscisse grav temperature_thermique Periode 0.000673 segment 82 0 0 0.002121 0
                  T_ordonnee grav temperature_thermique Periode 0.000673 segment 82 0 0 0 0.002121
                  T_angle grav temperature_thermique Periode 0.000673 segment 82 0 0 0.002121 0.002121
     
               # velocity_probe grav VitesseX Periode 1.e-4 segment 100 0. 1.875e-5 0.003 1.875e-5 #           
               }
   }
   
   liste_postraitements
   {
    postraitement_ft_lata post1 { 
     format Lata 
     fichier lata/post 
     champs dt_post 0.00673 { 
        VOLUME_MAILLE elem 
        indicatrice_interf elem 
        temperature_thermique elem
        vitesse elem
        pression elem 
        mpoint_thermique elem 
        interfacial_area elem 
        distance_interface_elem_interf elem
        # pression_laplacien_d elem #
        second_membre_projection elem
	second_membre_projection_jump elem
        vitesse
        vitesse_conv_thermique faces 
        vitesse_delta_interface faces 
        # terme_convection_vitesse faces 
        terme_diffusion_vitesse
        flux_tmp_interf faces  #
     } 
     interfaces interf { 
        courbure som 
        vitesse som 
        vitesse_repere_local som 
        COMPO_CONNEXE elem 
        PE elem 
        PE_LOCAL elem 
     } 
    }   
   }

sauvegarde binaire source.sauv
sauvegarde xyz source.xyz
# reprise binaire R0/source.sauv #
# reprise xyz R0/source.xyz #
# resume_last_time xyz R0/source.xyz #

}


Solve pb

End        

