# Boiling bubble simulation #
# PARALLEL OK #
dimension 2
PrecisionGeom 1e-18
bidim_axi

domaine dom_fluide
domaine dom_solide

# BEGIN MESH #
Mailler dom_fluide
{
  Pave pave1
  {
    origine 0. 0.
    longueurs 1. 1. 
    nombre_de_noeuds 101 101
    Facteurs 1.0 1.0
  }
  {
    bord left     X = 0.          0. <= Y <= 1.
    raccord local homogene bot      Y = 0.          0. <= X <= 1.
    bord right     X = 1.          0. <= Y <= 1.
    bord up      Y = 1.          0. <= X <= 1.
  }   
}
transformer dom_fluide x*0.0001 y*0.0001

Mailler dom_solide
{  
  Pave pave5
  { 
    origine 0. 0.
    longueurs 1. 1.
    nombre_de_noeuds 101 1001
    Facteurs 1.0 1.0
  }
  {
    raccord local homogene sup     Y = 1.          0. <= X <= 1.
    bord sbot     Y = 0.          0. <= X <= 1.
    bord sleft    X = 0.          0 <= Y <= 1.
    bord sright    X = 1.          0 <= Y <= 1.
  } 
}
transformer dom_solide x*0.0001 (y-1.)*0.001
# END MESH #

# BEGIN PARTITION
Partition dom_fluide
{
  Partitionneur tranche { tranches 2 3 }
  Larg_joint 2
  Nom_Zones DOM_FLUIDE
}

Partition dom_solide
{
  Partitionneur tranche { tranches 2 3 }
  Larg_joint 2
  Nom_Zones DOM_SOLIDE
}

Fin
END PARTITION #

# BEGIN SCATTER 
Scatter DOM_FLUIDE.Zones dom_fluide
Scatter DOM_SOLIDE.Zones dom_solide
 END SCATTER #


Probleme_FT_Disc_gen pb1
Pb_conduction pb2

Schema_Euler_explicite  sch
Lire sch
{
  tinit 0.0
	nb_pas_dt_max 3
  tmax 5.1e-6
  tcpumax 23.
  dt_min 1.e-18
  dt_max 1.02e-08
  dt_impr 5.e-8
  impr_diffusion_implicite 1
  dt_sauv 1.e-4
  facsec 1.
  seuil_statio 1e-12
  diffusion_implicite 0
  seuil_diffusion_implicite 1e-6
  periode_sauvegarde_securite_en_heures 6
}


Associate pb1 dom_fluide
Associate pb2 dom_solide

Probleme_Couple pbc
Associate pbc pb1
Associate pbc pb2

Associate pbc sch
VDF dis
Discretize pbc dis
option_vdf { All_options } # To set the BC of pressure on the Boundary, not at the center of ghost cells! #

Lire pb1
{
  solved_equations
  {
    Navier_stokes_FT_disc                         hydraulique
    Transport_interfaces_FT_disc                  interf
    convection_diffusion_temperature_ft_disc      thermique
    convection_diffusion_temperature_ft_disc      thermique_vapeur
  }

  Fluide_diphasique
  {
    fluide1 Fluide_Incompressible # eau #
    {
      mu champ_uniforme       1 2.8e-4
      rho champ_uniforme      1 958.37
      lambda champ_uniforme   1 0.679
      cp champ_uniforme       1 4.21e3
      beta_th champ_uniforme  1 0.0007504815417629351
    }
    fluide0 Fluide_Incompressible # vapeur #
    {
      mu champ_uniforme       1 1.227e-5
      rho champ_uniforme      1 0.597
      lambda champ_uniforme   1 0.025
      cp champ_uniforme       1 2.077e3
      beta_th champ_uniforme  1 0.002902383982248589
    }
    sigma   Champ_Uniforme 1            5.89e-2
    chaleur_latente Champ_Uniforme 1    -2.256e6
    gravite Champ_Uniforme 2 0. -9.81
    formule_mu harmonique
  }


  hydraulique
  {
    # parametre_equation parametre_diffusion_implicite
    {
	solveur petsc gcp { precond block_jacobi_ilu { level 0 } rtol 1.e-13 impr }
    } #
    modele_turbulence null { }
    solveur_pression GCP { precond ssor { omega 1.5 } seuil 1e-12 impr }
    convection { quick }
    diffusion { }
    conditions_initiales { vitesse champ_uniforme 2 0. 0. }
    # conditions_initiales { vitesse Champ_Fonc_reprise binaire STEADY/steady.sauv pb1 vitesse last_time  } #
    projection_initiale 0
    dt_projection 1.e-10 1.e-18
    equation_interfaces_proprietes_fluide interf
    equation_temperature_mpoint thermique
    equation_temperature_mpoint_vapeur thermique_vapeur
    new_mass_source   # -> it's a flag, when not activated, the variable is 0 #
    shift_secmem2 
    # when new_mass_source is used, it forces the use of the new jump(1/rho)*ai*mp as a source term in the RHS of Poisson instead of the historical div(delta_u) #
    interpol_indic_pour_dI_dt interp_modifiee # interp_ai_based #
    OutletCorrection_pour_dI_dt CORRECTION_GHOST_INDIC
    terme_gravite grad_I
    boussinesq_approximation
    boundary_conditions
    {
	# right   sortie_libre_rho_variable champ_front_fonc_xyz 1 0.  -958.37*9.81*(Y-0.009) cela depend de l'option terme_gravite #
	right   Symetrie
	bot     paroi_fixe
	up      sortie_libre_rho_variable champ_front_uniforme 1 0.
	left    Symetrie
    }
  }

  interf
  {
    type_indic_faces standard # interpolation to faces of indic : { STANDARD, MODIFIEE, AI_BASED } #
    # interpolation_repere_local #
    methode_interpolation_v vdf_lineaire
    methode_transport vitesse_interpolee hydraulique
    # conditions_initiales { fonction x^2+(y-2e-05*cos(12*pi/180.0))^2-2e-05^2 } #
    conditions_initiales { fonction x^2+y^2-2e-05^2 }
    VOFlike_correction_volume 1 # Flag to activate the VOF-like volume conservation (dI/dt) #
    nb_iterations_correction_volume 1 # to get the correct dI/dt #
    nb_lissage_correction_volume 1 # To smooth the dI/dt correction to avoid pikes on the interface #
    n_iterations_distance 8
    # Bloc Remesh Best #
    remaillage
    {
      pas 1e-12
      nb_iter_remaillage 3
      critere_arete 0.35
      pas_lissage 1e-12
      relax_barycentrage 0.1
      facteur_longueur_ideale 1.0
      nb_iter_barycentrage 1
      nb_iter_correction_volume 3
      seuil_dvolume_residuel 1e-15
      lissage_courbure_coeff -0.02
      lissage_courbure_iterations_systematique 1
      lissage_courbure_iterations_si_remaillage 5
    }
    # End Remesh Best #
    collisions
    {
      active
      juric_local  phase_continue 1
      type_remaillage Juric { source_isovaleur indicatrice }
    }
    parcours_interface { Correction_Parcours_Thomas }
    boundary_conditions
    {
      bot    Paroi_FT_disc constant champ_front_fonc_xyz 1 12 # to pinch contact line #
      right  Paroi_FT_disc Symetrie
      up     Paroi_FT_disc Symetrie
      left   Paroi_FT_disc Symetrie
    }
  }

  thermique
  {
    # parametre_equation parametre_diffusion_implicite
    {
      solveur petsc gcp { precond block_jacobi_ilu { level 0 } rtol 1.e-13 impr }
    } #
    # Pb quand on fait ça, il ne calcul pas le dt_stab de convection en FTD?? #
    # Parametre_equation parametre_implicite { resolution_explicite } #
    equation_interface interf
    equation_navier_stokes hydraulique
    phase 1
    stencil_width 9
    # correction_gradt_ordre 2 # 
    correction_mpoint_diff_conv_energy 3 0 0 0 # diff conv energy #
    diffusion { }
    convection { quick }
    boundary_conditions
    {
      bot ECHANGE_CONTACT_VDF_FT_DISC
      {
	AUTRE_PROBLEME pb2
	AUTRE_BORD sup 
	AUTRE_CHAMP_TEMPERATURE TEMPERATURE 
	NOM_MON_INDICATRICE INDICATRICE_INTERF 
	PHASE 1
	Ri_liq 0
       }
      up    frontiere_ouverte T_ext Champ_front_Uniforme 1 0.
      right PAROI_ADIABATIQUE
      left  Symetrie
    }
    # conditions_initiales { Temperature_thermique Champ_Don_lu dom_fluide 1 fluide.rep } # 
    conditions_initiales { Temperature_thermique Champ_Fonc_MED  { file fluide.med domain dom_fluide field Temperature_thermique last_time } }
  }


  thermique_vapeur
  {
    equation_interface interf
    equation_navier_stokes hydraulique
    phase 0
    stencil_width 9
    correction_mpoint_diff_conv_energy 3 0 0 0 # diff conv energy #
    divergence_free_velocity_extension
    solveur_pression_fictive  GCP { precond ssor { omega 1.5 } seuil 1e-15 impr }
    bc_opening_pressure  2 up right
    diffusion { }
    convection { quick }
    boundary_conditions
    {
      bot   ECHANGE_CONTACT_VDF_FT_DISC
      {
	AUTRE_PROBLEME pb2
	AUTRE_BORD sup
	AUTRE_CHAMP_TEMPERATURE TEMPERATURE
	NOM_MON_INDICATRICE INDICATRICE_INTERF
	PHASE 0
	Ri_liq 3.7e-6
      }
      up    frontiere_ouverte T_ext Champ_front_Uniforme 1 0.
      left  Symetrie
      right PAROI_ADIABATIQUE
    }
    conditions_initiales { Temperature_thermique_vapeur Champ_Fonc_xyz dom_fluide 1 0. }
  }


  Triple_Line_Model_FT_Disc
  {
    equation_navier_stokes hydraulique 
    equation_temperature thermique 
    equation_interface interf 
    # deactivate TCL #
    Qtcl 30.450 
    ym 2.130e-6 
    sm 4.956e-6 
    n_extend_meso 9 
    inout_method approx 
    read_via_file 1  
    file_name model.txt 
    adjust_meso_ML 
    Ri_thermal 0.00037 
    thetaC_tcl 12 
   } 


  postraitement 
  { 
    champs dt_post 5.e-7
    {
    }
    
    Probes 
    {
      T_vert grav temperature_thermique Periode 5.0e-8 segment 30 65.5e-6 0.5e-6 65.5e-6 29.9e-06
      T_vertbis grav temperature_thermique Periode 5.0e-8 segment 30 90.5e-6 0.5e-6 90.5e-6 29.9e-06
    }
  }
  liste_postraitements
  {
    postraitement_ft_lata post1 { 
    format lml
    champs dt_post 5.e-7
    { 
      VOLUME_MAILLE elem 
      indicatrice_interf elem 
      temperature_thermique elem
      temperature_thermique_vapeur elem 
      vitesse elem
      pression elem 
      mpoint_thermique elem
      mpoint_thermique_vapeur elem 
      interfacial_area elem 
      distance_interface_elem_interf elem
      # pression_laplacien_d elem 
      second_membre_projection elem
      vitesse
      vitesse_conv_thermique faces 
      vitesse_delta_interface faces 
      terme_convection_vitesse faces 
      terme_diffusion_vitesse
      flux_tmp_interf faces  #
    } 

    interfaces interf
    { 
      courbure som 
      vitesse som
    }
   }  
  }

# sauvegarde binaire source.sauv #
sauvegarde xyz source.xyz
# resume_last_time binaire STEADY/steady.sauv #
# Reprise binaire R0/source.sauv #
# Reprise xyz R0/source.xyz #
# resume_last_time xyz R0/source.xyz #
}

Read pb2
{
  Solide
  {
    gravite champ_uniforme 2 0 -9.81
    rho Uniform_Field 1 3980.
    lambda Champ_Uniforme 1 25.1
    Cp Champ_Uniforme 1 929.
  }
  Conduction
  {
    diffusion { }
    sources
    {
      Puissance_Thermique Champ_fonc_xyz dom_solide 1 4.25e+05*(y_ge_(1e-06))
    }
    boundary_conditions
    {
      sleft symetrie
      sright   PAROI_ADIABATIQUE
      sbot PAROI_ADIABATIQUE
      sup  echange_contact_VDF_FT_Disc_solid
      {
	autre_probleme pb1
	autre_bord bot
	autre_champ_temperature_indic1 temperature_thermique
	autre_champ_temperature_indic0 temperature_thermique_vapeur
	autre_champ_indicatrice indicatrice_interf
	dt_impr_Tw 5.e-8
	Ri_liq 0	
      }
    }
    # CONDITIONS_INITIALES { temperature Champ_Don_lu dom_solide 1 solide.rep } #
    CONDITIONS_INITIALES { temperature Champ_Fonc_MED  { file solide.med domain dom_solide field temperature last_time } }
  }

  Post_processing
  {
    Format lml
    fields dt_post 5.e-7
    {
      temperature elem
    } 
    Probes 
    {               
      T_vert_sol grav temperature Periode 5.e-8 segment 100 65.5e-6 -99.5e-06 65.5e-6 -0.5e-6 
      T_vert_solbis grav temperature Periode 5.e-8 segment 100 90.5e-6 -99.5e-06 90.5e-6 -0.5e-6                                                               
    } 
  }

# sauvegarde binaire source_sod.sauv #
sauvegarde xyz source_sod.xyz
# resume_last_time binaire STEADY/steady_sod.sauv #
# Reprise binaire R0/source_sod.sauv #
# Reprise xyz R0/source_sod.xyz #
# resume_last_time xyz R0/source_sod.xyz #
}
EcritureLectureSpecial 0

Imprimer_flux dom_fluide { bot }
Imprimer_flux_sum dom_fluide { bot }

Imprimer_flux_sum dom_solide { sup }
Imprimer_flux dom_solide { sup }

Solve pbc

# EcritureLectureSpecial 0 #
End

